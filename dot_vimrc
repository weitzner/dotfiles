filetype plugin indent on

set nu
set ts=2

" Visual
set showmatch

syntax enable
set background=dark
silent! colorscheme solarized   " guarded: don't error if solarized isn't installed

" Modern niceties
set incsearch
set ignorecase
set smartcase
set hlsearch
if !isdirectory($HOME . "/.vim/undo")
    call mkdir($HOME . "/.vim/undo", "p")
endif
set undofile
set undodir=$HOME/.vim/undo

" tell vim to use the system clipboard
set clipboard=unnamed
