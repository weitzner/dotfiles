# Layout configuration for Conda environments:
#
# Specify an environment name:
#   layout conda <envname>
#
# Detect the name from environment.yaml or environment.yml:
#   layout conda
#
# If the manifest has no name, use a local .conda environment.

layout_conda() {
    local _CONDA_ROOT
    local ENVIRONMENT_FILE
    local NAME
    local ACTIVATE_ARGS
    local CREATE_NEW_ENV=false

    # Different machines use different Conda distributions under
    # differently named roots. Detect the installed distribution.
    if [ -d "$HOME/miniforge3" ]; then
        _CONDA_ROOT="$HOME/miniforge3"
    elif [ -d "$HOME/mambaforge" ]; then
        _CONDA_ROOT="$HOME/mambaforge"
    elif [ -d "$HOME/miniconda3" ]; then
        _CONDA_ROOT="$HOME/miniconda3"
    else
        echo \
            "layout_conda: no miniforge3, mambaforge, or miniconda3 found under $HOME" \
            >&2
        return 1
    fi

    . "${_CONDA_ROOT}/etc/profile.d/conda.sh" || return $?

    if [ -n "${1:-}" ]; then
        NAME="$1"
    else
        if [ -f environment.yaml ] && [ -f environment.yml ]; then
            echo \
                "layout_conda: both environment.yaml and environment.yml exist" \
                >&2
            return 1
        elif [ -f environment.yaml ]; then
            ENVIRONMENT_FILE=environment.yaml
        elif [ -f environment.yml ]; then
            ENVIRONMENT_FILE=environment.yml
        else
            ENVIRONMENT_FILE=
        fi

        if [ -n "$ENVIRONMENT_FILE" ]; then
            NAME=$(
                sed -nE \
                    's/^[[:space:]]*name:[[:space:]]*"?([^"]+)"?[[:space:]]*$/\1/p' \
                    "$ENVIRONMENT_FILE" |
                    head -n 1
            )
        else
            NAME=
        fi
    fi

    if [ -n "$NAME" ]; then
        ACTIVATE_ARGS="$NAME"

        if ! conda env list |
            awk 'NF && $1 !~ /^#/ {print $1}' |
            grep -qFx "$NAME"
        then
            CREATE_NEW_ENV=true
        fi
    else
        ACTIVATE_ARGS="./.conda"

        if [ ! -d "$ACTIVATE_ARGS" ]; then
            CREATE_NEW_ENV=true
        fi
    fi

    if [ "$CREATE_NEW_ENV" = true ]; then
        if [ -n "$NAME" ]; then
            if [ -n "${ENVIRONMENT_FILE:-}" ]; then
                conda env create --file "$ENVIRONMENT_FILE" || return $?
            else
                conda create --yes --name "$NAME" || return $?
            fi
        else
            conda create --yes --prefix .conda || return $?
        fi
    fi

    conda activate "$ACTIVATE_ARGS"
}