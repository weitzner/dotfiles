# Layout configuration for conda environments:
#   Specify environment name with `layout conda <envname>`
#       or
#   Detect name from environment.yml with `layout conda`
#       or
#   Setup environment in `.conda`


layout_conda() {
  # Different machines use different conda distributions (miniforge3 vs
  # mambaforge vs miniconda3) under differently-named roots -- detect which
  # one is actually present rather than hardcoding one name.
  if [ -d "$HOME/miniforge3" ]; then
    _CONDA_ROOT="$HOME/miniforge3"
  elif [ -d "$HOME/mambaforge" ]; then
    _CONDA_ROOT="$HOME/mambaforge"
  elif [ -d "$HOME/miniconda3" ]; then
    _CONDA_ROOT="$HOME/miniconda3"
  else
    echo "layout_conda: no miniforge3/mambaforge/miniconda3 found under \$HOME" >&2
    return 1
  fi
  \. "${_CONDA_ROOT}/etc/profile.d/conda.sh" || return $?

  if [ -n "${1}" ]; then
    NAME="${1}"
  else
    NAME=$(grep name: environment.yml 2> /dev/null | sed -e 's/name: //')
  fi

  CREATE_NEW_ENV=false
  if [ -n "${NAME}" ]; then
    ACTIVATE_ARGS="${NAME}"
    CREATE_ARGS="-n ${NAME}"
    if ! conda env list | awk '{print $1}' | grep -qFx "${NAME}"; then
      CREATE_NEW_ENV=true
    fi
  else
    ACTIVATE_ARGS="./.conda"
    CREATE_ARGS="-p .conda"
    if [ ! -d "${ACTIVATE_ARGS}" ]; then
      CREATE_NEW_ENV=true
    fi
  fi;

  # Hard to resolve if an environment is valid, so just try to create instead.
  if [ "${CREATE_NEW_ENV}" = true ]; then
    conda create ${CREATE_ARGS}
  fi
  conda activate ${ACTIVATE_ARGS}
}
